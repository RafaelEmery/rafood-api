# Application configuration
APP_HOST=localhost
APP_PORT=8000

# Database configuration
DB_USER=local
DB_PASSWORD=local
# When running via docker-compose, use the database service name;
# use 'localhost' only when running outside Docker.
DB_HOST=database
DB_PORT=5432
DB_NAME=rafood_db

# Test database (pytest). Host: localhost + published DB_PORT. Overridden in docker-compose for api.
TEST_DB_HOST=localhost
TEST_DB_PORT=5434

# PG Admin (login below; server "Rafood" preloaded from docker/pgadmin-servers.json)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=local

# Logging configuration
LOG_LEVEL=INFO
LOG_JSON_FORMAT=False
LOG_NAME=rafood-api
LOG_ACCESS_NAME=rafood-api-access
LOGS_CORRELATION_HEADER_NAME=X-Request-ID

# Kafka CDC configuration (docker compose profile: kafka)
# Host-side ports only; containers talk to each other on the Docker network.
KAFKA_PORT=9092 # Broker listener published to the host (localhost:9092)
SCHEMA_REGISTRY_PORT=8081 # Avro schema registry HTTP API
KAFKA_CONNECT_PORT=8083 # Kafka Connect REST API (connector status)
CONTROL_CENTER_PORT=9021 # Confluent Control Center UI

# Monitoring configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=change-this-admin-user # Default admin username for Grafana
GRAFANA_ADMIN_PASSWORD=change-this-admin-password # Default admin password for Grafana
POSTGRES_EXPORTER_PORT=9187
CADVISOR_PORT=8080
