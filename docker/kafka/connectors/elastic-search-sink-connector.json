{
  "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
  "tasks.max": "1",
  "topics.regex": "outbox\\.event\\..*",
  "connection.url": "http://elasticsearch:9200",
  "key.ignore": "false",
  "schema.ignore": "true",
  "write.method": "upsert",
  "behavior.on.null.values": "delete",
  "predicates": "isDelete",
  "predicates.isDelete.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isDelete.pattern": "outbox\\.event\\..+\\.deleted",
  "transforms": "dropDeletedValue,indexName",
  "transforms.dropDeletedValue.type": "io.confluent.connect.transforms.Drop$Value",
  "transforms.dropDeletedValue.predicate": "isDelete",
  "transforms.indexName.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.indexName.regex": "outbox\\.event\\.([^.]+)\\..*",
  "transforms.indexName.replacement": "$1",
  "errors.log.enable": "true",
  "errors.log.include.messages": "true"
}
